# ============================================================================
# .env.example -- copy to .env and fill in. .env is secret: never commit it.
# See public/doc/installation.md (chapters 2 and 13).
# ============================================================================

# -- GCP / Firebase project (REQUIRED) -----------------------------------------
# Read by local scripts, deploy_batch.sh and cloud_batch/setup/*.sh.
# Cloud Functions detect the project automatically.
GCP_PROJECT=your-project-id
# GCP_LOCATION=us-central1
# Optional overrides (defaults shown in .env.update):
# TASKS_QUEUE=crm-queue
# WORKER_BASE_URL=            # derived from GCP_PROJECT + GCP_LOCATION when unset

# -- Firebase / Firestore -----------------------------------------------------
# Path to service account key file (used if FIREBASE_KEY_JSON is not set)
FIREBASE_CREDENTIALS=config/serviceAccountKey.json
# Or inline the key as one-line JSON (takes precedence over FIREBASE_CREDENTIALS)
FIREBASE_KEY_JSON=
# Firestore collection for leads (default: leads)
FIRESTORE_COLLECTION=leads

# -- OpenAI (AI enrichment) ---------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# -- Search APIs --------------------------------------------------------------
BRAVE_API_KEY=              # required for contact enrichment
BING_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# GitHub token -- improves rate limits for GitHub org search (no scopes needed)
GITHUB_TOKEN=

# -- Crawler tuning -----------------------------------------------------------
MAX_RESULTS=200
MIN_SCORE=50
MAX_PAGES=6
MAX_COUNTRY=1000
GIVE_UP_AFTER=15
CRAWL_DELAY=1.0
CRAWL_WORKERS=20
LIMIT_PER_HOST=3
QUERIES_FILE=

# -- Campaigns (legacy local runs) --------------------------------------------
CAMPAIGNS_DIR=
CAMPAIGN_LABEL=

# -- Mail accounts (alias "sales" = SALES_*) ----------------------------------
# Accounts are also configurable in the CRM (Mail accounts page); env is the fallback.
DEFAULT_MAIL_ACCOUNT=sales
SALES_SMTP_HOST=smtp.example.com
SALES_SMTP_PORT=465
SALES_SMTP_USER=sales@example.com
SALES_SMTP_PASSWORD=
SALES_FROM_NAME=Your Company
SALES_FROM_ADDR=sales@example.com
SALES_IMAP_HOST=imap.example.com
SALES_IMAP_PORT=993

# -- Sending limits and guards (defaults; per-account override in the CRM) -----
CAMPAIGN_SEND_DELAY_SECONDS=12      # pause between sends (deliverability throttle)
CAMPAIGN_WORKER_POLL_SECONDS=15     # how often the worker checks for queued campaigns
MAX_SENDS_PER_HOUR=50               # per-account hourly cap
MAX_SENDS_PER_DAY=300               # per-account daily cap
BOUNCE_RATE_PAUSE_THRESHOLD=0.05    # auto-pause campaign if failed ratio exceeds 5%

# -- Unsubscribe --------------------------------------------------------------
UNSUBSCRIBE_BASE_URL=       # e.g. https://YOUR_PROJECT_ID.web.app/unsubscribe?c={contact_id}
UNSUBSCRIBE_MAILTO=         # e.g. unsubscribe@example.com (List-Unsubscribe header)

# -- Reply handling -----------------------------------------------------------
REPLY_POLL_SECONDS=120      # how often to check inboxes for new messages
REPLY_LOOKBACK_DAYS=3       # how far back to scan on first run / after downtime
REPLY_ACCOUNTS=sales        # comma-separated account aliases to poll
REPLY_CLASSIFY_WITH_AI=false

# -- Google Drive folder (optional, gdisk) ------------------------------------
GDISK_FOLDER_ID=
GDISK_SERVICE_ACCOUNT=      # <project-number>-compute@developer.gserviceaccount.com

# -- Cloud Batch (optional) ---------------------------------------------------
# deploy_crm copies the BATCH_* values to functions-crm/.env -- do not edit that file.
BATCH_RUNNER_URL=           # set by deploy_batch.sh output
BATCH_SECRET=
BATCH_SA=                   # batch-runner@YOUR_PROJECT_ID.iam.gserviceaccount.com
