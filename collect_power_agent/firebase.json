{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [".venv\\Scripts\\python.exe firestore_sync.py --no-discover"]
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/unsubscribe", "function": { "functionId": "crmApi", "region": "us-central1" } }
    ]
  },
  "functions": [
    {
      "codebase": "crm",
      "source": "functions-crm",
      "runtime": "python312",
      "predeploy": [".venv\\Scripts\\python.exe sync_functions_env.py"],
      "ignore": ["venv", ".venv", "**/__pycache__/**"]
    },
    {
      "codebase": "auth",
      "source": "functions-auth",
      "runtime": "nodejs22",
      "ignore": ["node_modules"]
    }
  ]
}
